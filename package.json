{
  "name": "review-pen",
  "description": "Annotate long documents and turn your comments into precise, copy-ready revision prompts for AI tools. Local-first, no AI calls.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "dexie": "4.4.7",
    "github-slugger": "2.0.0",
    "hast-util-to-jsx-runtime": "2.3.7",
    "js-tiktoken": "1.0.21",
    "katex": "0.19.1",
    "mermaid": "12.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.6.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@types/unist": "3.0.3",
    "@wxt-dev/module-react": "1.2.2",
    "jsdom": "31.0.1",
    "typescript": "5.9.3",
    "vitest": "5.1.1",
    "wxt": "0.21.5"
  },
